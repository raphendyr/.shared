#!/bin/sh
set -e

cd "$(git rev-parse --show-toplevel)"

if version=$(git describe --exact-match 2>/dev/null); then
    echo "Current HEAD is tagged $version, can't tag more.."
    exit 0
fi

name=$(dpkg-parsechangelog -ldebian/changelog -S Source)
dist=$(dpkg-parsechangelog -ldebian/changelog -S Distribution)
version=$(dpkg-parsechangelog -ldebian/changelog -S Version)

if [ "$dist" = 'UNRELEASED' ]; then
    echo "$name ($version) is $dist"
    echo -n "Do you want to release it now ([Y]es/no)? "
    read answer
    case "$answer" in
        ''|[Yy]|[Yy]es)
            dch -r && exec "$0" "$@"
            ;;
        *) : ;;
    esac
    exit 0
fi

if latest_version=$(git describe --abbrev=0 2>/dev/null); then
    changes=$(dpkg-parsechangelog -ldebian/changelog -S Changes --since "$latest_version" | sed 's/^\.$//')
else
    changes=$(dpkg-parsechangelog -ldebian/changelog -S Changes --all | sed 's/^\.$//')
fi

git tag -s -a "$version" -m "Release $version" -m "$changes"
