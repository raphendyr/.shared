#!/usr/bin/env bash
set -eu

name=${0##*/}
usage() {
	echo "usage: $name script.sh arg1..."
}
if [[ $# -eq 0 ]]; then
	usage >&2
	exit 2
fi
if [[ ! -e $1 ]]; then
	echo "$name: $1: No such file or directory"
	usage >&2
	exit 127
fi

if [[ ${NO_COLOR:-} ]]; then
	PS4='+> '
else
	PS4=$(printf '%b' '\e[32;1m+>\e[0m \n')
fi
export PS4

shebang=$(head -n1 "$1")
if [[ ! $shebang =~ ^#!/ ]]; then
	echo "$name: $1: No #!/... in the first line"
	usage >&2
	exit 127
elif [[ $shebang =~ ^#!/usr/bin/env ]]; then
	shell=${shebang#* }
	read -r _ shell _ <<<"$shebang"
else
	read -r shell _ <<<"$shebang"
	shell=${shell##*/}
fi
if [[ ! $shell =~ sh$ ]]; then
	echo "$name: $1: No shell detected, found '$shell' from '$shebang'"
	usage >&2
	exit 127
fi

exec "$shell" -x "$@"
